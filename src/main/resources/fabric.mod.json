{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "Iron431",
    "Lab3"
  ],
  "contact": {
    "homepage": "${mod_display_url}",
    "sources": "https://github.com/iron431/Irons-Spells-n-Spellbooks",
    "issues": "${mod_issue_tracker}"
  },
  "license": "${mod_license}",
  "icon": "assets/irons_spellbooks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.redspace.ironsspellbooks.IronsSpellbooksFabric"
    ],
    "client": [
      "io.redspace.ironsspellbooks.IronsSpellbooksFabricClient"
    ]
  },
  "mixins": [
    "irons_spellbooks.mixins.json",
    "irons_lib.mixins.json",
    "mixins.epicironcompat.json",
    "mixins.ironsarms.json"
  ],
  "accessWidener": "irons_spellbooks.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "geckolib": ">=4.9.3",
    "playeranimator": ">=2.0.4",
    "trinkets": ">=3.10.0"
  },
  "suggests": {
    "jei": "*",
    "azurelib": "*",
    "biolith": "*",
    "cloth-config": "*",
    "epicfight": "*",
    "tacz": "*"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/world/entity/Entity": [
        "net/neoforged/neoforge/attachment/IAttachmentHolder",
        "net/neoforged/neoforge/entity/IEntityExtension"
      ],
      "net/minecraft/world/level/block/entity/BlockEntity": [
        "net/neoforged/neoforge/common/extensions/IBlockEntityExtension"
      ],
      "net/minecraft/world/level/Level": [
        "net/neoforged/neoforge/attachment/IAttachmentHolder"
      ],
      "net/minecraft/world/level/chunk/ChunkAccess": [
        "net/neoforged/neoforge/attachment/IAttachmentHolder"
      ],
      "net/minecraft/world/item/ItemStack": [
        "net/neoforged/neoforge/common/extensions/IItemStackExtension"
      ],
      "net/minecraft/world/item/Item": [
        "net/neoforged/neoforge/common/extensions/IItemExtension"
      ],
      "net/minecraft/core/Holder": [
        "net/neoforged/neoforge/common/extensions/IHolderExtension"
      ],
      "net/minecraft/server/packs/resources/SimpleJsonResourceReloadListener": [
        "net/neoforged/neoforge/common/conditions/IConditionalOpsProvider"
      ],
      "net/minecraft/world/level/block/state/BlockBehaviour": [
        "net/neoforged/neoforge/common/extensions/IBlockExtension"
      ],
      "net/minecraft/world/level/block/state/BlockBehaviour$BlockStateBase": [
        "net/neoforged/neoforge/common/extensions/IBlockStateExtension"
      ],
      "net/minecraft/world/level/material/Fluid": [
        "net/neoforged/neoforge/common/extensions/IFluidExtension"
      ],
      "net/minecraft/world/entity/player/Player": [
        "net/neoforged/neoforge/common/extensions/IPlayerExtension"
      ],
      "net/minecraft/client/renderer/blockentity/BlockEntityRenderer": [
        "net/neoforged/neoforge/client/extensions/common/IBlockEntityRendererExtension"
      ],
      "net/minecraft/client/particle/Particle": [
        "net/neoforged/neoforge/common/extensions/IParticleExtension"
      ],
      "net/minecraft/world/level/LevelAccessor": [
        "net/neoforged/neoforge/common/extensions/ILevelAccessorExtension"
      ],
      "net/minecraft/client/resources/model/BakedModel": [
        "net/neoforged/neoforge/client/extensions/IBakedModelExtension"
      ],
      "net/minecraft/client/KeyMapping": [
        "net/neoforged/neoforge/client/extensions/IKeyMappingExtension"
      ],
      "net/minecraft/world/item/Item$Properties": [
        "net/neoforged/neoforge/common/extensions/IItemPropertiesExtension"
      ],
      "net/minecraft/client/renderer/DimensionSpecialEffects": [
        "net/neoforged/neoforge/client/extensions/IDimensionSpecialEffectsExtension"
      ],
      "net/minecraft/world/item/CreativeModeTab$Builder": [
        "net/neoforged/neoforge/common/extensions/ICreativeModeTabBuilderExtension"
      ],
      "net/minecraft/world/entity/LightningBolt": [
        "net/neoforged/neoforge/common/extensions/ILightningBoltExtension"
      ],
      "net/minecraft/core/particles/BlockParticleOption": [
        "net/neoforged/neoforge/common/extensions/IBlockParticleOptionExtension"
      ]
    }
  }
}